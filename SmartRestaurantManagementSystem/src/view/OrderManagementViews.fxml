                                                      <Label fx:id="lblTax" text="\$3.68" textFill="#333333"><font><Font name="System Bold" size="10.5" /></font></Label>
                                                   </children>
                                                </HBox>
                                                <HBox>
                                                   <children>
                                                      <Label text="Discount" textFill="#666666"><font><Font size="10.5" /></font></Label>
                                                      <Region HBox.hgrow="ALWAYS" />
                                                      <Label fx:id="lblDiscount" text="\$0.00" textFill="#333333"><font><Font name="System Bold" size="10.5" /></font></Label>
                                                   </children>
                                                </HBox>
                                             </children>
                                          </VBox>

                                          <!-- Total Amount -->
                                          <HBox alignment="CENTER_LEFT" style="-fx-padding: 6 0 0 0;">
                                             <children>
                                                <Label text="Total Amount" textFill="#1A1A1A"><font><Font name="System Bold" size="13.0" /></font></Label>
                                                <Region HBox.hgrow="ALWAYS" />
                                                <Label fx:id="lblTotalAmount" text="\$49.64" textFill="#E05A10"><font><Font name="System Bold" size="15.0" /></font></Label>
                                             </children>
                                          </HBox>

                                       </children>
                                    </VBox>

                                 </children>
                              </HBox>

                              <!-- Action Buttons: Clear & Place Order -->
                              <HBox alignment="CENTER_RIGHT" spacing="12.0">
                                 <children>
                                    <Button fx:id="btnClearOrder" onAction="#handleClearOrder" style="-fx-background-color: #FFFFFF; -fx-border-color: #E2E8F0; -fx-border-radius: 6; -fx-padding: 8 16; -fx-cursor: hand;" text="🗑️  Clear Order" textFill="#475569">
                                       <font><Font name="System Bold" size="11.0" /></font>
                                    </Button>
                                    <Button fx:id="btnPlaceOrder" onAction="#handlePlaceOrder" style="-fx-background-color: #E05A10; -fx-background-radius: 6; -fx-padding: 8 20; -fx-cursor: hand;" text="🟧  Place Order" textFill="WHITE">
                                       <font><Font name="System Bold" size="11.0" /></font>
                                    </Button>
                                 </children>
                              </HBox>

                           </children>
                        </VBox>

                        <!-- RIGHT: Recent Orders Panel -->
                        <VBox prefHeight="618.0" prefWidth="437.0" spacing="12.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 10; -fx-padding: 18; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.02), 6, 0, 0, 1);">
                           <children>
                              <HBox alignment="CENTER_LEFT">
                                 <children>
                                    <Label text="Recent Orders" textFill="#1A1A1A"><font><Font name="System Bold" size="13.5" /></font></Label>
                                    <Region HBox.hgrow="ALWAYS" />
                                    <TextField fx:id="txtSearchOrders" onKeyReleased="#handleSearchOrders" prefWidth="130.0" promptText="🔍 Search orders..." style="-fx-background-color: #F8F9FA; -fx-border-color: #E2E8F0; -fx-border-radius: 6; -fx-padding: 4 8;" />
                                 </children>
                              </HBox>

                              <!-- View All Orders Button -->
                              <HBox alignment="CENTER">
                                 <VBox.margin>
                                    <Insets top="5.0" />
                                 </VBox.margin>
                              </HBox>
                              <TableView fx:id="tableRecentOrders" prefHeight="526.0" prefWidth="375.0">
                                <columns>
                                  <TableColumn fx:id="colRecentOrderID" prefWidth="85.0" text="Order ID" />
                                  <TableColumn fx:id="colRecentCustomer" prefWidth="90.0" text="Customer" />
                                    <TableColumn fx:id="colRecentStatus" prefWidth="95.0" text="Status" />
                                    <TableColumn fx:id="colRecentTotal" prefWidth="100.0" text="Total" />
                                </columns>
                              </TableView>

                           </children>
                        </VBox>

                     </children>
                  </HBox>

               </children>
            </VBox>
         </content>
      </ScrollPane>
   </center>

</BorderPane>
